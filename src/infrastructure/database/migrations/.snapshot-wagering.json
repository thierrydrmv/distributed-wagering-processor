      "checks": [
        {
          "name": "wager_transactions_amount_valid",
          "columnName": "kind",
          "definition": "CHECK ((((kind = 'LOSS'::text) AND (amount = (0)::numeric)) OR ((kind = 'WIN'::text) AND (amount >= (0)::numeric)) OR ((kind = ANY (ARRAY['OPENING'::text, 'BET'::text, 'REFUND'::text, 'ROLLBACK'::text])) AND (amount > (0)::numeric))))",
          "expression": "(kind = 'LOSS'::text) AND (amount = (0)) OR (kind = 'WIN'::text) AND (amount >= (0)) OR (kind = ANY (ARRAY['OPENING'::text, 'BET'::text, 'REFUND'::text, 'ROLLBACK'::text])) AND (amount > (0))"
        },
        {
          "name": "wager_transactions_currency_supported",
          "columnName": "currency",
          "definition": "CHECK (((currency)::text ~ '^(BRL|USD|EUR|GBP)$'::text))",
          "expression": "currency ~ '^(BRL|USD|EUR|GBP)$'::text"
        },
        {
          "name": "wager_transactions_processing_result",
          "columnName": "processed_at",
          "definition": "CHECK ((((status = 'PROCESSED'::text) AND (processed_at IS NOT NULL) AND (result_balance IS NOT NULL) AND (failure_code IS NULL)) OR ((status = ANY (ARRAY['REJECTED'::text, 'FAILED'::text])) AND (processed_at IS NULL) AND (failure_code IS NOT NULL)) OR ((status = ANY (ARRAY['PENDING'::text, 'PENDING_REFERENCE'::text])) AND (processed_at IS NULL) AND (result_balance IS NULL) AND (failure_code IS NULL))))",
          "expression": "((status = 'PROCESSED'::text) AND (processed_at IS NOT NULL) AND (result_balance IS NOT NULL) AND (failure_code IS NULL)) OR ((status = ANY (ARRAY['REJECTED'::text, 'FAILED'::text])) AND (processed_at IS NULL) AND (failure_code IS NOT NULL)) OR ((status = ANY (ARRAY['PENDING'::text, 'PENDING_REFERENCE'::text])) AND (processed_at IS NULL) AND (result_balance IS NULL) AND (failure_code IS NULL))"
        },
        {
          "name": "wager_transactions_required_reference",
          "columnName": "kind",
          "definition": "CHECK (((kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR ((reference_external_transaction_id IS NOT NULL) AND (length(TRIM(BOTH FROM reference_external_transaction_id)) > 0))))",
          "expression": "(kind <> ALL (ARRAY['REFUND'::text, 'ROLLBACK'::text])) OR ((reference_external_transaction_id IS NOT NULL) AND (length(TRIM(BOTH FROM reference_external_transaction_id)) > 0))"
        },
        {
          "name": "wager_transactions_result_balance_non_negative",
          "columnName": "result_balance",
          "definition": "CHECK (((result_balance IS NULL) OR (result_balance >= (0)::numeric)))",
          "expression": "result_balance IS NULL) OR (result_balance >= (0)"
        }
